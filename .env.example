# GROQ_API_KEY: Required for Whisper speech-to-text and Llama text cleanup.
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Optional: Text cleanup provider ("groq" or "local")
CLEANUP_PROVIDER="groq"

# URL for local fine-tuned model FastAPI server (from /training/serve_local.py)
LOCAL_CLEANUP_URL="http://localhost:8000/cleanup"
